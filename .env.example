# API Endpoints
VITE_API_BASE_URL=http://localhost:3000/api
VITE_NEWS_API_ENDPOINT=/news
VITE_UPDATES_API_ENDPOINT=/updates
VITE_CONTACT_API_ENDPOINT=/contact

# PostgreSQL Database Credentials
VITE_DB_HOST=localhost
VITE_DB_PORT=5432
VITE_DB_NAME=your_database_name
VITE_DB_USER=your_database_user
VITE_DB_PASSWORD=your_database_password

# JWT Authentication
VITE_JWT_SECRET=your_jwt_secret_key
VITE_JWT_EXPIRES_IN=24h

# Other Configuration
VITE_APP_NAME=HYDRAA
VITE_APP_ENV=development 